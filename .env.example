# Startup Radar environment variables. Copy to .env and adjust; .env is gitignored.
# Every value below is a placeholder or the built-in default. Never commit real tokens.

# HTTP port the server binds on 0.0.0.0 (Railway injects PORT automatically).
PORT=3000

# Directory for the SQLite database (startup-radar.db), created if missing. On Railway set /data (the volume mount).
DATA_DIR=./data

# Minutes between refresh cycles; integer clamped to 5..1440.
REFRESH_MINUTES=30

# Bearer token for POST /api/refresh. Leave empty to disable the endpoint (it answers 404). Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_TOKEN=

# Product Hunt Developer Token (producthunt.com/v2/oauth/applications -> create app -> "Developer Token"); switches Product Hunt from the Atom feed to the GraphQL API (adds vote counts).
PRODUCTHUNT_TOKEN=

# Crunchbase v4 user key; enables the Crunchbase funding-rounds adapter (otherwise shown as "not configured").
CRUNCHBASE_API_KEY=

# Set to true to enable r/SideProject + r/startups (Atom). Off by default: Reddit returned 403/429 to cloud IPs during verification.
ENABLE_REDDIT=false

# Public base URL of this deployment; used in the outbound User-Agent "StartupRadar/1.0 (+PUBLIC_URL)". Set to your Railway domain.
PUBLIC_URL=http://localhost:3000
